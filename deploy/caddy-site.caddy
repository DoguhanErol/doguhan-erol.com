# Paste into the Caddy that already serves qrivo.online.
# Do not delete qrivo.online, www, files, or the tenant wildcard.
# These names are literal on purpose: that Caddy's {$ROOT_DOMAIN} is qrivo.online.
# Containers must be on the web-edge network before reloading Caddy.

www.doguhan-erol.com {
	redir https://doguhan-erol.com{uri} permanent
}

files.doguhan-erol.com {
	reverse_proxy doguhan-portfolio-minio:9000
}

doguhan-erol.com {
	reverse_proxy doguhan-portfolio-app:3000
}
