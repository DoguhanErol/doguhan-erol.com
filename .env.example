# Yerel geliştirme. Docker: npm run local
# Host'tan (npm run dev): bu dosyayı .env olarak kopyalayın.

NEXT_PUBLIC_ROOT_DOMAIN=localhost:3010
NODE_ENV=development
PORT=3010

POSTGRES_PASSWORD=portfolio
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio

AUTH_SECRET=local-dev-secret-change-me-32-characters-min
NEXTAUTH_URL=http://localhost:3010

MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=portfolio
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9010/portfolio

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=doguhan
SEED_ADMIN_PASSWORD=admin123
