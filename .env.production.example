# =============================================================================
# Production .env şablonu — VPS'te: cp .env.production.example .env && nano .env
# Bu dosyayı gerçek şifrelerle commit ETMEYİN.
# Domain: doguhan-erol.com
# =============================================================================

POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://portfolio:change-me-db-password@db:5432/portfolio

NEXT_PUBLIC_ROOT_DOMAIN=doguhan-erol.com
NEXTAUTH_URL=https://doguhan-erol.com

# openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET_NAME=portfolio
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://files.doguhan-erol.com/portfolio

CADDY_EMAIL=admin@doguhan-erol.com

# Bu proje Qrivo ile aynı makinede kendi Caddy'sini 80/443'e bind etmez.
# Sertifika, Qrivo Caddy'sine deploy/caddy-site.caddy eklenince gelir.

# İlk deploy'da init-db bu hesap yoksa oluşturur. Sonraki deploy şifreyi ezmez.
SEED_ADMIN_EMAIL=admin@doguhan-erol.com
SEED_ADMIN_USERNAME=doguhan
SEED_ADMIN_PASSWORD=change-me-strong-password

TZ=Europe/Istanbul
